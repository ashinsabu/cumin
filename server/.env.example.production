# Production environment template — copy to .env on the server, fill in real values.
# Never commit the actual .env file.

# Server
PORT=8080
ENV=production

# Database — use the full connection string from Railway (or wherever the DB lives)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Auth — generate a strong random secret (e.g. openssl rand -hex 32)
AUTH_DISABLED=false
JWT_SECRET=<strong-random-secret-min-32-chars>

# Google OAuth — from console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Comma-separated native app (iOS) OAuth client IDs for /api/auth/google/mobile
GOOGLE_MOBILE_CLIENT_IDS=
GOOGLE_REDIRECT_URL=https://api.cumin.ashinsabu.com/api/auth/google/callback

# Frontend origin — must match the deployed URL exactly (no trailing slash)
FRONTEND_URL=https://cumin.ashinsabu.com
