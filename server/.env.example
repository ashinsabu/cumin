# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://cumin:cumin@localhost:5432/cumin?sslmode=disable

# Auth
AUTH_DISABLED=true
JWT_SECRET=local-dev-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated native app (iOS) OAuth client IDs for /api/auth/google/mobile
GOOGLE_MOBILE_CLIENT_IDS=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Comma-separated allowed frontend origins (CORS + post-auth redirect target)
ALLOWED_ORIGINS=http://localhost:3000
